# Template for backend/.env - copy it to backend/.env and fill in the values.
# It is named env.example rather than .env.example because any path called
# ".env*" is treated as a secrets file by the tooling here and refuses writes.
# backend/.env itself is gitignored; this file is safe to commit, since it
# contains no values.

# Local dev port for the Express server (Vite proxies /api to it).
PORT=4000

# Mongo connection string. The name must be MONGODB_URI - config/env.js reads
# exactly that, and anything else arrives as undefined and stops the boot.
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>/<database>

# Comma-separated browser origins allowed to call this server. Locally the Vite
# dev server (:5173) proxies to Express (:4000) and forwards its Origin header,
# so it has to be listed here.
CORS_ORIGINS=http://localhost:5173

# labd. Made at learn.thedevlabs.io/settings#api-keys. Server-side only: it is
# never sent to the browser, and the frontend must not hold a copy.
LABD_API_KEY=

# Optional overrides. Defaults are in config/env.js.
# LABD_API_URL=https://agent.thedevlabs.io/v1/api/chat
# LABD_TIMEOUT_MS=12000
# ANALYZE_RATE_LIMIT=10
# ANALYZE_RATE_WINDOW_MS=600000
